# Get a key at https://maker.tavus.io/dev/api-keys
TAVUS_API_KEY=
# Optional: a different stock or custom face
# TAVUS_FACE_ID=rc9cff32ceba
# Optional: skip .tavus.json and point at an existing PAL
# TAVUS_PAL_ID=
# Visitors need this code to start a video session. Set it on any public URL.
# ACCESS_CODE=
# Longest a video session may run, in seconds (default and Tavus's ceiling: 3600)
# MAX_CALL_SECONDS=3600
# Audit log: a Postgres connection string. Without it, events are kept in memory only.
# DATABASE_URL=
# Turns on the audit dashboard at /admin (use a long random value)
# ADMIN_TOKEN=
# Days of audit events to keep (default 0 = keep everything)
# AUDIT_RETENTION_DAYS=0
